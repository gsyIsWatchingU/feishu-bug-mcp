FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxx
FEISHU_VIEW_ID=vewxxxxxxxxxxxx

# 默认即可适配以下表头：
# 编号、功能模块、Bug问题描述、优先级、解决状态、提交时间、解决日期、验证结果、验证时间、备注
FEISHU_FIELD_ID=编号
FEISHU_FIELD_TITLE=Bug问题描述
FEISHU_FIELD_STATUS=解决状态
FEISHU_FIELD_PRIORITY=优先级
FEISHU_FIELD_MODULE=功能模块
FEISHU_FIELD_CREATED_AT=提交时间
FEISHU_FIELD_RESOLVED_AT=解决日期
FEISHU_FIELD_VERIFICATION_RESULT=验证结果
FEISHU_FIELD_VERIFICATION_TIME=验证时间
FEISHU_FIELD_COMMENT=备注
FEISHU_FIELD_REMARK=备注

# 可选扩展字段
# FEISHU_FIELD_SEVERITY=严重程度
# FEISHU_FIELD_REPO_HINT=仓库/项目
# FEISHU_FIELD_DESCRIPTION=详细描述
# FEISHU_FIELD_REPRO_STEPS=复现步骤
# FEISHU_FIELD_EXPECTED_RESULT=预期结果
# FEISHU_FIELD_ACTUAL_RESULT=实际结果
# FEISHU_FIELD_ASSIGNEE=处理人
# FEISHU_FIELD_ATTACHMENTS=附件
# FEISHU_FIELD_UPDATED_AT=更新时间
